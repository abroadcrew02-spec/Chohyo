{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chouhyo-ocr/schema/template.schema.json",
  "title": "帳票OCRツール テンプレート",
  "description": "座標定義ファイルの正本。Python コアは読み込み時に、テンプレート編集画面は保存前に、このファイルで検証する。設計は 02_design.md §4.2。スキーマは将来の様式（左右分割・4分割・複数ページ1帳票）を表現できるが、v1 の実装は受け入れ範囲を絞る（各プロパティの v1受入 を参照）。範囲外は読み込み時に拒否し、黙って続行しない。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "template_id",
    "render_dpi",
    "image",
    "record",
    "faces"
  ],
  "properties": {
    "schema_version": {
      "description": "既知のバージョンでなければ読み込みを拒否する。自動マイグレーションもフォールバックも実装しない（02_design.md §4.2）。",
      "type": "integer",
      "const": 1
    },
    "template_id": {
      "description": "様式の識別子。中間データやログに残す。",
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "render_dpi": {
      "description": "PDF を画像へ展開するときの解像度。座標は dpi に依存するため、座標と同じファイルに置く（設定ファイルの6項目には含めない）。",
      "type": "integer",
      "minimum": 72,
      "maximum": 1200
    },
    "image": {
      "description": "入力ページ1枚の期待サイズ。面のサイズではない。展開画像はまずこの寸法へ正規化してから source.rect で切り出す（02_design.md §4.2 座標系）。",
      "$ref": "#/$defs/size"
    },
    "record": {
      "description": "1帳票（出力1行）が消費する入力ページ数。出力行数 = 入力ページ数 ÷ record.pages。割り切れなければ実行前にエラーで停止する。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pages"
      ],
      "properties": {
        "pages": {
          "description": "v1受入: 1 のみ。2以上は「表面が1ページ目・裏面が2ページ目」型の様式のための拡張余地。",
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        }
      }
    },
    "faces": {
      "description": "帳票の面。v1受入: face_id が front と back の2要素のみ。左右分割・4分割は要素数と source.rect の取り方で表現する。",
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/face"
      }
    }
  },
  "$defs": {
    "size": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "w",
        "h"
      ],
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        },
        "w": {
          "type": "integer",
          "minimum": 1
        },
        "h": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "kind": {
      "description": "項目種別。text は OCR の読取値を、choice は丸印など選択の判定結果を値とする。抽出方式はこの属性だけで決まり、項目名の命名規則には依存しない（要件 §5.2）。元号は choice の一例であって特例ではない。",
      "type": "string",
      "enum": [
        "text",
        "choice"
      ]
    },
    "face": {
      "description": "1つの面。source 以外の矩形はすべて面ローカル座標（位置合わせ後の面画像の左上が原点、寸法は source.rect の w×h）。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "face_id",
        "source"
      ],
      "properties": {
        "face_id": {
          "description": "面の識別子。中間データの alignment と token.face の結合キーになるため、改名すると既存トークンが使えなくなる（02_design.md §6.7 幾何セクション）。v1受入: front または back。",
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "source": {
          "description": "この面を入力ページのどこから切り出すか。ここだけが入力ページ座標。",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "page_offset",
            "rect"
          ],
          "properties": {
            "page_offset": {
              "description": "帳票内での入力ページ番号（0 起点）。record.pages 未満でなければならない。v1受入: 0 のみ。",
              "type": "integer",
              "minimum": 0,
              "maximum": 15
            },
            "rect": {
              "description": "入力ページ座標での切り出し矩形。この w×h が面ローカル座標空間の寸法になる。",
              "$ref": "#/$defs/rect"
            }
          }
        },
        "exclusions": {
          "description": "除外領域（綴じ穴帯・黒塗り等）。抽出対象外であるだけでなく、二値化閾値の決定にも用いない（要件 §5.2）。位置合わせ前は膨張させて当てる（02_design.md §6.2 の2パス）。",
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "rect"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "rect": {
                "$ref": "#/$defs/rect"
              }
            }
          }
        },
        "fields": {
          "description": "単発欄（繰り返しでない欄）。field_id はテンプレート全体で一意でなければならない——JSON Schema では表現できないため読み込み時に検証する。",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/field"
          }
        },
        "tables": {
          "description": "繰り返し欄。行はここから格子として展開する。矩形を1行ずつ列挙しない。",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/table"
          }
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field_id",
        "kind",
        "rect"
      ],
      "properties": {
        "field_id": {
          "description": "出力列名と同一（02_design.md §4.1・§4.3）。面とは独立で、person_ は本人欄というグループを指し表面を指すのではない。",
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "kind": {
          "$ref": "#/$defs/kind"
        },
        "rect": {
          "$ref": "#/$defs/rect"
        },
        "extra_rects": {
          "description": "追加の領域（任意・kind が text のときのみ）。主の rect と合わせて1つの欄を構成する矩形の集合で、どの領域に入った文字も同じ欄の値として読み順（座標順）に連結される。L字・コの字の欄を作るために使う。出力列は増えない。面ローカル座標。",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/rect"
          }
        },
        "fallback_rect": {
          "description": "参照先の枠（任意・kind が text のときのみ）。主の rect に文字が1つも検出されなかったときに限り、この枠の読取値を採用する。主にインクがあるが読めない（〓）場合は参照しない——答えは主に書かれているのに別の場所の値を出すと誤転記になるため（転記主義）。面ローカル座標。",
          "$ref": "#/$defs/rect"
        },
        "choice_marks": {
          "description": "kind が choice のときのみ意味を持ち、そのとき必須。各選択肢の印字文字の外接矩形で、環状帯はこの外側からセル境界までを取る（02_design.md §6.8）。",
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "rect"
            ],
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              },
              "rect": {
                "$ref": "#/$defs/rect"
              }
            }
          }
        },
        "normalize": {
          "description": "値の正規化方式。amount = 金額正規化（D-01: 桁区切り除去・整数化。判定不能は〓）。抽出・正規化の方式はこの属性と kind で決まり、列名には依存しない（要件 §5.2）。 kind が choice のセル、および subfields を持つセルでは無視される（choice は丸印判定・subfields は分割が優先）。",
          "enum": [
            "amount"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "choice"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "choice_marks"
            ]
          },
          "else": {
            "not": {
              "required": [
                "choice_marks"
              ]
            }
          }
        }
      ]
    },
    "table": {
      "description": "繰り返し欄の定義。blocks を定義順に走り、各ブロックで rows 回だけ origin.y + row_pitch * i を計算して行の上端を求める。行の通し番号はブロックを跨いで連番（左ブロック 01..、右ブロック はその続き）。読み順「左→右」は blocks の定義順で表す。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "table_id",
        "row_pitch",
        "row_height",
        "blocks",
        "columns"
      ],
      "properties": {
        "table_id": {
          "description": "field_id の接頭辞になる（例: family → family_01_続柄）。",
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "row_pitch": {
          "description": "行の上端どうしの間隔（px・面ローカル）。",
          "type": "integer",
          "minimum": 1
        },
        "row_height": {
          "description": "1行の高さ（px・面ローカル）。row_pitch 以下であること（行が重ならないため）——読み込み時に検証する。",
          "type": "integer",
          "minimum": 1
        },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "origin",
              "rows"
            ],
            "properties": {
              "origin": {
                "description": "このブロックの1行目・1列目の左上（面ローカル）。",
                "$ref": "#/$defs/point"
              },
              "rows": {
                "type": "integer",
                "minimum": 1,
                "maximum": 200
              }
            }
          }
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/tableColumn"
          }
        }
      }
    },
    "tableColumn": {
      "description": "テーブルの1列。矩形は x = origin.x + x_offset、y = 行の上端、幅 = width、高さ = row_height で決まる。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "x_offset",
        "width",
        "kind"
      ],
      "properties": {
        "name": {
          "description": "field_id の末尾になる（例: 続柄 → family_01_続柄）。",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "x_offset": {
          "type": "integer",
          "minimum": 0
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "$ref": "#/$defs/kind"
        },
        "choice_marks": {
          "description": "kind が choice のときのみ意味を持ち、そのとき必須。横位置は x_offset/width、縦位置は y_offset/height（省略時は行全体）。家族欄では昭平令が行内に縦積みされるため縦指定が要る。",
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "x_offset",
              "width"
            ],
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              },
              "x_offset": {
                "type": "integer",
                "minimum": 0
              },
              "width": {
                "type": "integer",
                "minimum": 1
              },
              "y_offset": {
                "description": "行上端からのオフセット（px）。省略時は行全体。家族欄のように選択肢が行内へ縦に積まれる様式で使う。",
                "type": "integer",
                "minimum": 0
              },
              "height": {
                "description": "マークの高さ（px）。省略時は行の残り全部。",
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "subfields": {
          "description": "複合セル（kind が text のセル専用。choice では無視される——issue #26）。1つの矩形に書かれた値（例: 家族欄の生年月日『7.7.20』）を、区切り文字で分割して subfields の数だけ出力列にする（列名は <name>_<subfield>）。分割規則は 02_design.md D-23。分割数が合わない場合は当該サブ列すべてを〓にする。物理的に別セルが並ぶ場合（明細の年月日）はこの属性を使わず列を分ける。",
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          }
        },
        "normalize": {
          "description": "値の正規化方式。amount = 金額正規化（D-01: 桁区切り除去・整数化。判定不能は〓）。抽出・正規化の方式はこの属性と kind で決まり、列名には依存しない（要件 §5.2）。 kind が choice のセル、および subfields を持つセルでは無視される（choice は丸印判定・subfields は分割が優先）。",
          "enum": [
            "amount"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "choice"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "choice_marks"
            ]
          },
          "else": {
            "not": {
              "required": [
                "choice_marks"
              ]
            }
          }
        }
      ]
    }
  }
}
