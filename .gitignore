# --- 個人情報・要配慮個人情報（要件 §6.5）---------------------------
# 実運用の帳票は指定端末のみで扱い、検証後に削除する。リポジトリへ入れない。
/samples/real/
/samples/**/real/
# 帳票のスキャン画像。samples/ 限定だと notes/帳票.png・docs/screenshot.png・
# samples/scan001.tif が素通りする（実測・issue #52 M-9）。拡張子を全階層で落として、
# 正当な同梱アセットだけを戻す。ingest が受け付ける拡張子はすべて対象（issue #9）。
*.png
*.jpg
*.jpeg
*.tif
*.tiff
*.bmp
# 戻すのは png だけにする。ディレクトリごと `!gui/public/**` で戻すと、後続の
# ルールより前に書かれた行がすべて無効化される——実際 `*.pdf` をこの上に置いていた
# 間は gui/public/scan001.pdf が ignore されなかった（実測: check-ignore が
# `.gitignore:16:!gui/public/**` を返した）。この2ディレクトリで追跡中のファイルは
# png 14件・svg 2件・icns/ico 各1件で、svg/icns/ico はどのルールにも当たらないため
# 戻す必要がない（git ls-files で確認）。
!gui/src-tauri/icons/**/*.png
!gui/public/**/*.png
# PDF は否定行より後ろに置く。gitignore は後勝ちで、前に置くと上の否定に負ける。
*.pdf

# 中間データ（読取値・信頼度・展開画像を含む）
workdir/
intermediate/
*.sqlite
*.sqlite3
*.db

# 利用者のテンプレート保存先（templates/ とは別。templates/ は Tauri が
# 配布物へ丸ごと同梱するため、顧客固有テンプレートの置き場にはできない
# ——07要件 v0.4 変更点2・AZKi M-6。現状は *.json ルールの副作用で偶然
# 無視されているだけだったため、明示行として残す）
/templates_user/

# 出力（帳票の記入値そのもの）
output/
# 拡張子で全階層を落とす。output_ で始まる名前だけを見ていた間は、納品用に
# 改名した customer.xlsx・results/final.csv・docs/顧客一覧.xlsx がどれも
# 素通りしていた（実測: check-ignore が NOT IGNORED・issue #98）。出力先は
# GUI から任意のフォルダへ変えられるので、リポジトリ配下に置かれる前提で書く。
# 追跡中のこの拡張子のファイルは 0 件のため、戻す否定行は要らない
# （git ls-files で確認・2026-09-03）。表計算を新しく追跡するときは、
# 帳票の記入値でないことを確かめてから否定行をここへ足す。
*.xlsx
*.xls
*.xlsm
*.csv
# 列名一覧の併記ファイルと、アトミック差し替えの一時ファイル。xlsx/csv と
# 同じ出力先に同じ timestamp で並ぶ（render_out.py の output_<日時>_columns.txt・
# .xlsx.tmp / .csv.tmp / .txt.tmp）。列名だけとはいえ様式の構成が読めるうえ、
# .tmp は中身が本体と同一
*_columns.txt
*.tmp

# ログ（記入値は書かない設計だが、事故時の保険として除外）
logs/
app.log
error.log

*.dpapi

# --- 資格情報 -------------------------------------------------------
# GCP のサービスアカウント鍵は <project-id>-<hash>.json という名前で降ってくる。
# 名前ベースの列挙（service-account*.json 等）も、直下限定の /*.json も取りこぼす——
# core/gcp-key.json・gui/auth.json・docs/key.json・core/chouhyo_ocr/creds.json は
# いずれも素通りしていた（実測・issue #52 M-8）。全階層の .json を落として、
# 追跡中の正当な .json だけを個別に戻す。
# .json を新しく追加するときは、鍵でないことを確かめてからここへ1行足す。
*.json
# templates 直下のみ戻す（再帰させない）。エディタの保存既定が templates/
# 直下のため、再帰で戻すと下書き・実験ファイルまで追跡対象になりうる
# （issue #59 H-7）。下書きは templates/drafts/ に置けば無視される。
!/templates/*.json
!/schema/**/*.json
!/design/canvas.json
!/gui/package.json
!/gui/package-lock.json
!/gui/tsconfig.json
!/gui/tsconfig.node.json
!/gui/src-tauri/tauri.conf.json
!/gui/src-tauri/capabilities/*.json
# 保存のトランザクション化（issue #56 T1）で生じる作業ファイル。.saving.json
# は templates/ 直下だと *.json → !/templates/*.json の再包含に巻き込まれて
# 追跡対象になっていた（実測: NOT IGNORED・マリン最終レビュー M-5）
*.saving.json
*.bak
*.key
*.pem
.env
.env.*

# --- 作業ログ（ローカル完結・リモート非公開）------------------------
/worklog/

# --- 配布ビルド成果物 ---------------------------------------------
/core-dist/
/workdir_build/

# --- Python ---------------------------------------------------------
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
# カバレッジ計測の作業ファイル（run_all_tests.py --coverage）。pytest の cwd が
# core/ なので core/.coverage に出る。.coverage.* は xdist がワーカーごとに書く
# 分割ファイルで、結合前に落ちると残る。読める形の成果物は
# workdir_build/coverage/ 側（こちらも除外済み）。
.coverage
.coverage.*

# --- Node / Tauri ---------------------------------------------------
node_modules/
dist/
target/
/src-tauri/target/

# --- OS / エディタ --------------------------------------------------
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/

# --- 同梱バイナリ（配布時に配置・リポジトリには入れない）------------
/vendor/poppler/

# design canvas の seed 済み成果物（再生成可能・~2MB）
/design/chouhyo-ocr-gui.html

# 検証資産（testdata/）のうち合成テンプレート JSON と合成画像 PNG だけを戻す。
# `!testdata/**` のような丸ごと否定は、上の *.key/*.pem/*.dpapi/*.sqlite/.env/*.pdf の
# 除外まで testdata 配下で全て打ち消す（2026-09-02 セキュリティレビュー H-1）。
# 戻す拡張子は最小限にし、鍵 JSON の混入は pre-commit の内容検査に委ねる。
# 配布物には同梱されない（tauri.conf は templates/ のみ同梱）。経緯は
# docs/design/chouhyo-ocr/06_second_form_findings.md §2
# 戻すのはワイルドカードでなく実在パスの列挙にする。`!/testdata/**/*.json` だと
# testdata 配下に置いた任意の JSON が追跡対象へ戻り、たとえば
# testdata/formB/responses/本番読取_p0001.json（実データの Vision 応答）が
# NOT IGNORED になる（実測・AZKi レビュー M-4）。追跡を増やすときは
# git ls-files testdata で現物を確かめてから1行足す。
!/testdata/golden_manifest.json
!/testdata/formB/formB-v1.json
!/testdata/formB/responses/formB-1_p0001.json
!/testdata/formB/formB-1.png
# 検証素材のローカル置き場（#88）。記入値を含む実サンプル・保存済み Vision 応答・
# golden 出力を置く。中間データ（workdir/）と同居していると purge --yes で
# 消えて golden 比較と性能計測が再現できなくなるため、purge の対象外へ分けた。
# 中身は記入値を含むので追跡しない。上の否定行より後ろに置く——gitignore は
# 後勝ちで、前に置くと `!/testdata/...` の再包含に負ける。
/testdata/local/
# 否定行より後ろに置いて打ち消す（:67 の *.saving.json は上の否定に負ける・再検証 LOW）
/testdata/**/*.saving.json
